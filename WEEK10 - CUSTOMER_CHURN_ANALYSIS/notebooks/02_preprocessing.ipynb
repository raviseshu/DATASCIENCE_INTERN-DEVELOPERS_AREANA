     }
    }
   ],
   "execution_count": 6
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-01-25T14:14:23.691392Z",
     "start_time": "2026-01-25T14:14:22.962408Z"
    }
   },
   "source": [
    "# 4. OUTLIER DETECTION (IQR Method)\n",
    "def detect_outliers_iqr(df, column):\n",
    "    Q1 = df[column].quantile(0.25)\n",
    "    Q3 = df[column].quantile(0.75)\n",
    "    IQR = Q3 - Q1\n",
    "    lower = Q1 - 1.5 * IQR\n",
    "    upper = Q3 + 1.5 * IQR\n",
    "    outliers = df[(df[column] < lower) | (df[column] > upper)]\n",
    "    return outliers, lower, upper\n",
    "\n",
    "monthly_outliers, low, high = detect_outliers_iqr(df, 'MonthlyCharges')\n",
    "print(f'MonthlyCharges outliers: {len(monthly_outliers)} ({len(monthly_outliers)/len(df):.1%})')\n",
    "\n",
    "# Visualize outliers\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.boxplot([df['MonthlyCharges'], monthly_outliers['MonthlyCharges']], labels=['All', 'Outliers'])\n",
    "plt.title('Monthly Charges Outlier Detection (IQR)')\n",
    "plt.savefig('../plots/outlier_detection.png', dpi=300)\n",
    "plt.show()"
   ],
   "id": "79bcf5dbea8675af",
   "outputs": [
    {
