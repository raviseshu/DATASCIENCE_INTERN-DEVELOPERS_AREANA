   "source": [
    "# 🔧 DAY 2-4: DATA PREPROCESSING PIPELINE\n",
    "**3 Encoding Methods + 2 Scaling Techniques + Outlier Handling**"
   ],
   "id": "34be08611b8f9ae"
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-01-25T14:12:58.589977Z",
     "start_time": "2026-01-25T14:12:51.357149Z"
    }
   },
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.preprocessing import LabelEncoder, OneHotEncoder, StandardScaler, MinMaxScaler\n",
    "from scipy import stats\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "df = pd.read_csv('../data/customer_churn.csv')\n",
    "print('Original shape:', df.shape)"
   ],
   "id": "29df7beb9feeb1ef",
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Original shape: (500, 9)\n"
     ]
    }
   ],
   "execution_count": 1
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-01-25T14:13:30.561345Z",
     "start_time": "2026-01-25T14:13:30.495353Z"
    }
   },
   "source": [
    "# 1. LABEL ENCODING (Ordinal Data)\n",
    "le = LabelEncoder()\n",
    "df['tenure_bucket'] = pd.cut(df['Tenure'], bins=[0, 12, 36, 72], labels=['short', 'medium', 'long'])\n",
    "df['tenure_encoded'] = le.fit_transform(df['tenure_bucket'])\n",
    "print('Label Encoded:\\n', df['tenure_encoded'].value_counts())"
   ],
   "id": "2c67659ab200c413",
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Label Encoded:\n",
      " tenure_encoded\n",
      "0    254\n",
      "1    162\n",
      "2     84\n",
      "Name: count, dtype: int64\n"
     ]
    }
   ],
   "execution_count": 3
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-01-25T14:13:37.806554Z",
     "start_time": "2026-01-25T14:13:37.768593Z"
    }
   },
   "source": [
    "# 2. ONE-HOT ENCODING (Nominal Data)\n",
    "ohe = OneHotEncoder(drop='first', sparse_output=False)\n",
    "contract_encoded = ohe.fit_transform(df[['Contract']])\n",
    "contract_df = pd.DataFrame(contract_encoded, columns=ohe.get_feature_names_out(['Contract']))\n",
    "df = pd.concat([df, contract_df], axis=1)\n",
    "print('One-hot shape:', contract_df.shape)"
   ],
   "id": "6c71ef647bc0d3b3",
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "One-hot shape: (500, 2)\n"
     ]
    }
   ],
   "execution_count": 4
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-01-25T14:14:17.201780Z",
     "start_time": "2026-01-25T14:14:15.235149Z"
    }
   },
   "source": [
    "# 3. FEATURE SCALING COMPARISON [web:242]\n",
    "scaler_standard = StandardScaler()\n",
    "scaler_minmax = MinMaxScaler()\n",
    "\n",
    "# Standard Scaling (Z-score)\n",
    "df['tenure_standard'] = scaler_standard.fit_transform(df[['Tenure']])\n",
    "\n",
    "# Min-Max Scaling (0-1)\n",
    "df['tenure_minmax'] = scaler_minmax.fit_transform(df[['Tenure']])\n",
    "\n",
    "# Visualize\n",
    "plt.figure(figsize=(12, 4))\n",
    "plt.subplot(1, 3, 1)\n",
    "plt.hist(df['Tenure'], bins=30, alpha=0.7); plt.title('Original')\n",
    "plt.subplot(1, 3, 2)\n",
    "plt.hist(df['tenure_standard'], bins=30, alpha=0.7); plt.title('StandardScaler')\n",
    "plt.subplot(1, 3, 3)\n",
    "plt.hist(df['tenure_minmax'], bins=30, alpha=0.7); plt.title('MinMaxScaler')\n",
    "plt.tight_layout()\n",
    "plt.savefig('../plots/scaling_comparison.png', dpi=300)\n",
    "plt.show()"
   ],
   "id": "c4233c54106decf",
   "outputs": [
    {
     "data": {
      "text/plain": [
       "<Figure size 1200x400 with 3 Axes>"
      ],
      "image/png": ""
