   "source": [
    "# 🔧 WEEK 10 DAY 2: DATA PREPROCESSING\n",
    "**Cleaning → Scaling → Encoding → Pipeline Ready**"
   ],
   "id": "3dff8c3372e92497"
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-01-26T08:12:49.803997Z",
     "start_time": "2026-01-26T08:12:42.431427Z"
    }
   },
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.preprocessing import StandardScaler, LabelEncoder, OneHotEncoder\n",
    "from sklearn.compose import ColumnTransformer\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "df = pd.read_csv('../data/customer_churn.csv')\n",
    "print('Raw data shape:', df.shape)"
   ],
   "id": "be3b64541925dce4",
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Raw data shape: (500, 9)\n"
     ]
    }
   ],
   "execution_count": 2
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-01-26T08:12:54.810255Z",
     "start_time": "2026-01-26T08:12:51.533969Z"
    }
   },
   "source": [
    "# 1. DATA CLEANING\n",
    "print('Missing values:\\n', df.isnull().sum())\n",
    "\n",
    "# Convert TotalCharges to numeric\n",
    "df['TotalCharges'] = pd.to_numeric(df['TotalCharges'], errors='coerce')\n",
    "\n",
    "# OUTLIER DETECTION [plots/04_outlier_detection.png]\n",
    "fig, axes = plt.subplots(1, 3, figsize=(18, 6))\n",
    "for i, col in enumerate(['Tenure', 'MonthlyCharges', 'TotalCharges']):\n",
    "    df.boxplot(column=col, ax=axes[i])\n",
    "    axes[i].set_title(f'{col} Outliers')\n",
    "plt.savefig('../plots/04_outlier_detection.png', dpi=300)\n",
    "plt.show()"
   ],
   "id": "5ce0230df8090a59",
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Missing values:\n",
      " CustomerID          0\n",
      "Tenure              0\n",
      "MonthlyCharges      0\n",
      "TotalCharges        0\n",
      "Contract            0\n",
      "PaymentMethod       0\n",
      "PaperlessBilling    0\n",
      "SeniorCitizen       0\n",
      "Churn               0\n",
      "dtype: int64\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "<Figure size 1800x600 with 3 Axes>"
      ],
      "image/png": ""
     },
     "metadata": {},
     "output_type": "display_data",
     "jetTransient": {
      "display_id": null
     }
    }
   ],
   "execution_count": 3
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-01-26T08:13:01.463243Z",
     "start_time": "2026-01-26T08:12:58.725672Z"
    }
   },
   "source": [
    "# 2. PREPROCESSING PIPELINE\n",
    "numeric_features = ['Tenure', 'MonthlyCharges']\n",
    "categorical_features = ['Contract', 'PaymentMethod']\n",
    "\n",
    "preprocessor = ColumnTransformer([\n",
    "    ('num', StandardScaler(), numeric_features),\n",
    "    ('cat', OneHotEncoder(drop='first', sparse_output=False), categorical_features)\n",
    "])\n",
    "\n",
    "# Test scaling [plots/03_scaling_comparison.png]\n",
    "X_sample = df[numeric_features]\n",
    "X_scaled = preprocessor.fit_transform(df[numeric_features + categorical_features])[:, :2]\n",
    "\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 5))\n",
    "ax1.hist(X_sample['Tenure'], alpha=0.7)\n",
    "ax1.set_title('Before Scaling')\n",
    "ax2.hist(X_scaled[:, 0], alpha=0.7)\n",
    "ax2.set_title('After Scaling')\n",
    "plt.savefig('../plots/03_scaling_comparison.png', dpi=300)\n",
    "plt.show()\n",
    "\n",
    "print('✅ Preprocessing pipeline ready')"
   ],
   "id": "465f8d7d62ade93e",
