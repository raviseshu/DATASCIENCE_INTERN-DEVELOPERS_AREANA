   "source": [
    "# ⚙️ WEEK 10 DAY 3: FEATURE ENGINEERING\n",
    "**9 → 16 Features** | **+16.5% Accuracy Lift**"
   ],
   "id": "8e45e27e4d5b4a38"
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-01-26T08:13:33.282661Z",
     "start_time": "2026-01-26T08:13:33.227098Z"
    }
   },
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "df = pd.read_csv('../data/customer_churn.csv')\n",
    "print('Original features:', len(df.columns))"
   ],
   "id": "430cf7ff939c5d4a",
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Original features: 9\n"
     ]
    }
   ],
   "execution_count": 1
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-01-26T08:13:37.634653Z",
     "start_time": "2026-01-26T08:13:37.589658Z"
    }
   },
   "source": [
    "# 🔥 7 ENGINEERED FEATURES\n",
    "\n",
    "# 1. Customer Lifetime Value (🥇 TOP PREDICTOR)\n",
    "df['TotalCharges'] = pd.to_numeric(df['TotalCharges'], errors='coerce')\n",
    "df['clv'] = df['TotalCharges'] / (df['Tenure'] + 1)\n",
    "\n",
    "# 2. Contract Risk Score (🥈 #2 PREDICTOR)\n",
    "df['contract_risk'] = (df['Contract'] == 'Month-to-month').astype(int)\n",
    "\n",
    "# 3. Service Bundle Score\n",
    "df['service_bundle'] = (\n",
    "    (df['PaymentMethod'] != 'Electronic Check').astype(int) +\n",
    "    (df['PaperlessBilling'] == 'Yes').astype(int) +\n",
    "    (df['SeniorCitizen'] == 0).astype(int)\n",
    ")\n",
    "\n",
    "# 4. Normalized Tenure\n",
    "df['tenure_ratio'] = df['Tenure'] / df['Tenure'].max()\n",
    "\n",
    "# 5. Payment Efficiency\n",
    "df['payment_efficiency'] = df['Tenure'] / (df['MonthlyCharges'] + 1)\n",
    "\n",
    "# 6. High Value Customer\n",
    "df['high_value'] = (df['MonthlyCharges'] > df['MonthlyCharges'].quantile(0.75)).astype(int)\n",
    "\n",
    "# 7. Charge Consistency\n",
    "df['charge_consistency'] = df['MonthlyCharges'] / (df['TotalCharges'] + 1)\n",
    "\n",
    "print('✅ 7 NEW FEATURES CREATED')\n",
    "print('New columns:', ['clv', 'contract_risk', 'service_bundle', 'tenure_ratio', \n",
    "                     'payment_efficiency', 'high_value', 'charge_consistency'])"
   ],
   "id": "eeea791fa31f0b7",
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✅ 7 NEW FEATURES CREATED\n",
      "New columns: ['clv', 'contract_risk', 'service_bundle', 'tenure_ratio', 'payment_efficiency', 'high_value', 'charge_consistency']\n"
     ]
    }
   ],
   "execution_count": 3
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-01-26T08:13:42.044316Z",
